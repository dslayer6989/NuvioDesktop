+            .clip(shape)
+            .then(
+                if (selected) {
+                    Modifier.background(LiveTvNeon.AccentGradient)
+                } else {
+                    Modifier.background(LiveTvNeon.SurfaceRaised).border(1.dp, LiveTvNeon.GridLineStrong, shape)
+                },
